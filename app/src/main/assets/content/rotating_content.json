[
  {
    "id": 1,
    "text": "إِنَّ اللَّهَ لَا يُغَيِّرُ مَا بِقَوْمٍ حَتَّىٰ يُغَيِّرُوا مَا بِأَنفُسِهِمْ",
    "source": "سورة الرعد — الآية ١١",
    "type": "verse"
  },
  {
    "id": 2,
    "text": "وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِّلْعَالَمِينَ",
    "source": "سورة الأنبياء — الآية ١٠٧",
    "type": "verse"
  },
  {
    "id": 3,
    "text": "إِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ",
    "source": "صحيح البخاري",
    "type": "hadith"
  },
  {
    "id": 4,
    "text": "الدِّينُ النَّصِيحَةُ",
    "source": "صحيح مسلم",
    "type": "hadith"
  },
  {
    "id": 5,
    "text": "وَقُل رَّبِّ زِدْنِي عِلْمًا",
    "source": "سورة طه — الآية ١١٤",
    "type": "verse"
  },
  {
    "id": 6,
    "text": "مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ طَرِيقًا إِلَى الْجَنَّةِ",
    "source": "صحيح مسلم",
    "type": "hadith"
  },
  {
    "id": 7,
    "text": "إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ",
    "source": "سورة البقرة — الآية ٢٢٢",
    "type": "verse"
  },
  {
    "id": 8,
    "text": "خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ",
    "source": "صحيح البخاري",
    "type": "hadith"
  }
]
